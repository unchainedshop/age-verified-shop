{
  "compilerOptions": {
    // TypeScript 7 defaults "strict" to true; this project has always been
    // non-strict, so keep that posture explicit rather than annotate everything.
    "strict": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    "module": "nodenext",
    "outDir": "lib",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "esnext",
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
