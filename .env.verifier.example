# Copy to .env.verifier and fill in SIGNING_KEY. Used by docker-compose.verifier-dev.yml.
#
# The DID + verification method below are the existing swiyu-INT (test) verifier
# identity from swiyu-stack.yml / metadata.json — reuse them for dev, or swap in
# your own registered DID.
VERIFIER_DID=did:tdw:QmUHPe91p2Vmamjmb696UAo6ZZQogyyEFB4DVic2uzGBqo:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:e3277fbe-0bec-4c64-aaf9-77c95745523b
DID_VERIFICATION_METHOD=did:tdw:QmUHPe91p2Vmamjmb696UAo6ZZQogyyEFB4DVic2uzGBqo:identifier-reg.trust-infra.swiyu-int.admin.ch:api:v1:did:e3277fbe-0bec-4c64-aaf9-77c95745523b#auth-key-01

# REQUIRED: the private signing key matching VERIFIER_DID (kept out of git).
# In the production stack this is the $SIGNING_KEY secret.
SIGNING_KEY=

# Shared secret for the verifier -> engine webhook. If you also set
# SWIYU_WEBHOOK_API_KEY to this value on the engine, the callback is authenticated;
# otherwise the engine skips the check.
WEBHOOK_API_KEY_VALUE=dev-webhook-key

# Public URL of the verifier as seen by the SWIYU wallet. localhost only makes the
# QR/link render; for real wallet scanning use a tunnel, e.g.:
#   cloudflared tunnel --url http://localhost:8080
# then set EXTERNAL_URL to the https URL it prints.
EXTERNAL_URL=http://localhost:8080
